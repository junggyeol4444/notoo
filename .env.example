# 저장소 -------------------------------------------------------------------
# SQLite가 기본. 외부 서비스 없이 바로 돈다.
NF_DATABASE_URL=sqlite:///data/novel_factory.db
# PostgreSQL로 옮길 때
# NF_DATABASE_URL=postgresql+psycopg://novel:password@localhost:5432/novel_factory
# NF_VECTOR_BACKEND=pgvector

NF_DATA_DIR=data
NF_ECHO_SQL=false

# LLM (집필 엔진) ------------------------------------------------------------
# 로컬 추론 서버의 OpenAI 호환 엔드포인트를 가리킨다.
# 비워 두면 참고작 분석과 장기기억 DB만 동작한다. Phase 1~2는 이걸로 충분하다.
#
#   Ollama         http://localhost:11434/v1
#   LM Studio      http://localhost:1234/v1
#   vLLM           http://localhost:8000/v1
#   llama.cpp      http://localhost:8080/v1
#   text-gen-webui http://localhost:5000/v1
NF_LLM_BASE_URL=
NF_LLM_MODEL=
# 로컬 서버는 보통 키를 요구하지 않는다.
NF_LLM_API_KEY=
NF_LLM_TIMEOUT_SEC=300
NF_LLM_TEMPERATURE=0.8
# 계획·추출처럼 정해진 형식이 필요한 호출의 온도
NF_LLM_STRUCTURED_TEMPERATURE=0.3
# 모델 컨텍스트 길이(토큰). Writer에 넘길 설정·요약을 이 안에 맞춘다.
NF_LLM_CONTEXT_TOKENS=65536
# 한국어 1글자당 토큰 수 추정치. 토크나이저마다 다르다. 쓰는 모델로 재 보고 맞출 것.
NF_LLM_TOKENS_PER_CHAR=1.0
# 서버가 response_format={"type":"json_object"}를 지원하면 true
NF_LLM_JSON_MODE=false
# 형식이 틀린 구조화 응답을 다시 요청하는 횟수
NF_LLM_STRUCTURED_RETRIES=2

# 장편 기억 검색 (기획안 41번) -----------------------------------------------
# auto: 임베딩 모델이 있으면 의미 검색, 없으면 어휘 검색 / embedding / lexical / off
NF_MEMORY_SEARCH=auto
# 로컬 서버의 /v1/embeddings. 주소를 비우면 NF_LLM_BASE_URL을 쓴다.
NF_EMBEDDING_BASE_URL=
NF_EMBEDDING_MODEL=
NF_EMBEDDING_BATCH_SIZE=32
# Writer에게 보여 줄 과거 장면 수, 장면당 발췌 글자 수, 색인 조각 크기
NF_MEMORY_TOP_K=4
NF_MEMORY_EXCERPT_CHARS=500
NF_MEMORY_CHUNK_CHARS=800

# 자동 집필 스케줄러 (기획안 42번) --------------------------------------------
# 서버 안에서 매일 이 시각에 돈다. 작품마다 PUT /novels/{slug}/schedule로 켜야 쓴다.
NF_SCHEDULER_ENABLED=true
NF_SCHEDULER_TIME=03:00
# 비우면 서버 로컬 시간. 예: Asia/Seoul
NF_SCHEDULER_TIMEZONE=

# 집필 ---------------------------------------------------------------------
NF_SCENE_MIN_CHARS=700
NF_SCENE_MAX_CHARS=1600
NF_WRITER_TAIL_CHARS=1500
NF_WRITER_MIN_LENGTH_RATIO=0.7
NF_SIMILARITY_REWRITE_ATTEMPTS=2

# 품질 검사 (기획안 34~38번) -------------------------------------------------
# FAIL 장면을 고쳐 쓰고 다시 검사하는 최대 횟수. 0이면 검사만 한다.
NF_QUALITY_FIX_ROUNDS=2
# Logic 검사(LLM)
NF_QUALITY_LOGIC=true
# Reader Simulation(LLM). 페르소나마다 원고 전체를 읽히므로 느리다.
NF_QUALITY_READER=false
NF_QUALITY_READER_PERSONAS=["웹소설 독자", "판타지 독자", "로맨스 독자", "까다로운 독자"]

# 표지 (기획안 43번) ---------------------------------------------------------
# 이미지 서버. 비우면 그림 없이 글자 표지를 만든다.
#   openai  OpenAI 호환 /v1/images/generations   (주소 예: http://localhost:8080/v1)
#   a1111   Stable Diffusion WebUI /sdapi/v1/txt2img (주소 예: http://localhost:7860)
NF_IMAGE_BASE_URL=
NF_IMAGE_API=openai
NF_IMAGE_MODEL=
NF_IMAGE_WIDTH=832
NF_IMAGE_HEIGHT=1248
NF_COVER_WIDTH=1600
NF_COVER_HEIGHT=2400
NF_THUMBNAIL_WIDTH=400
NF_THUMBNAIL_HEIGHT=600
# 한글 글꼴 파일. 비우면 나눔·Noto CJK·맑은 고딕 등 흔한 위치에서 찾는다.
NF_COVER_FONT=

# 출판 (기획안 45번) ---------------------------------------------------------
# files: 파일로 내보낸다 (사람이 플랫폼에 올린다)
# webhook: 사용자가 만든 API로 POST한다
NF_PUBLISH_TARGETS=[{"name": "files", "type": "files"}]
# NF_PUBLISH_TARGETS=[{"name": "files", "type": "files"}, {"name": "내서버", "type": "webhook", "url": "https://example.com/hook", "token": "..."}]
NF_PUBLISH_MAX_ATTEMPTS=3

# 분석 파라미터 --------------------------------------------------------------
# 회차 마커를 못 찾았을 때 강제 분할 기준
NF_FALLBACK_EPISODE_CHARS=5000
# 클리프행어 판정에 쓸 회차 말미 글자 수
NF_CLIFFHANGER_TAIL_CHARS=400
# 대형 사건으로 볼 사건 강도 상위 백분위
NF_MAJOR_EVENT_PERCENTILE=0.85

# 저장소 -------------------------------------------------------------------
# SQLite가 기본. 외부 서비스 없이 바로 돈다.
NF_DATABASE_URL=sqlite:///data/novel_factory.db
# PostgreSQL로 옮길 때
# NF_DATABASE_URL=postgresql+psycopg://novel:password@localhost:5432/novel_factory
# NF_VECTOR_BACKEND=pgvector

NF_DATA_DIR=data
NF_ECHO_SQL=false

# LLM (집필 엔진) ------------------------------------------------------------
# 로컬 추론 서버의 OpenAI 호환 엔드포인트를 가리킨다.
# 비워 두면 참고작 분석과 장기기억 DB만 동작한다. Phase 1~2는 이걸로 충분하다.
#
#   Ollama         http://localhost:11434/v1
#   LM Studio      http://localhost:1234/v1
#   vLLM           http://localhost:8000/v1
#   llama.cpp      http://localhost:8080/v1
#   text-gen-webui http://localhost:5000/v1
NF_LLM_BASE_URL=
NF_LLM_MODEL=
# 로컬 서버는 보통 키를 요구하지 않는다.
NF_LLM_API_KEY=
NF_LLM_TIMEOUT_SEC=300
NF_LLM_TEMPERATURE=0.8
# 계획·추출처럼 정해진 형식이 필요한 호출의 온도
NF_LLM_STRUCTURED_TEMPERATURE=0.3
# 모델 컨텍스트 길이(토큰). Writer에 넘길 설정·요약을 이 안에 맞춘다.
NF_LLM_CONTEXT_TOKENS=65536
# 한국어 1글자당 토큰 수 추정치. 토크나이저마다 다르다. 쓰는 모델로 재 보고 맞출 것.
NF_LLM_TOKENS_PER_CHAR=1.0
# 서버가 response_format={"type":"json_object"}를 지원하면 true
NF_LLM_JSON_MODE=false
# 형식이 틀린 구조화 응답을 다시 요청하는 횟수
NF_LLM_STRUCTURED_RETRIES=2

# 집필 ---------------------------------------------------------------------
NF_SCENE_MIN_CHARS=700
NF_SCENE_MAX_CHARS=1600
NF_WRITER_TAIL_CHARS=1500
NF_WRITER_MIN_LENGTH_RATIO=0.7
NF_SIMILARITY_REWRITE_ATTEMPTS=2

# 분석 파라미터 --------------------------------------------------------------
# 회차 마커를 못 찾았을 때 강제 분할 기준
NF_FALLBACK_EPISODE_CHARS=5000
# 클리프행어 판정에 쓸 회차 말미 글자 수
NF_CLIFFHANGER_TAIL_CHARS=400
# 대형 사건으로 볼 사건 강도 상위 백분위
NF_MAJOR_EVENT_PERCENTILE=0.85
